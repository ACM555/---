# ====== 服务配置 ======
APP_NAME=Outbound-Guard API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====== 超级管理员（必须在本地 .env 中设置，禁止提交真实密码）======
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-local-password

# ====== 演示账号（可选）======
# DEMO_MODE=true 且 DEMO_USERNAME、DEMO_PASSWORD 均非空时，服务启动会自动创建该账号。
# 权限与普通注册用户一致，不是管理员；同名账号已存在时不覆盖，也不重置密码。
# 现场演示仍推荐使用「扫码体验」游客入口，创建独立临时会话。
DEMO_MODE=false
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_COMPANY=GoAI 演示账号

# ====== CORS ======
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====== AI / RAG 模型（按优先级选择一个提供方）======
# 方案 A：智谱 GLM（推荐；OpenAI 兼容接口）
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 方案 B：科大讯飞星火
# 在讯飞开放平台控制台取得 HTTP 服务的 APIPassword；真实密钥只写入本地 .env，禁止提交。
IFLYTEK_API_PASSWORD=your-iflytek-api-password-here
IFLYTEK_BASE_URL=https://spark-api-open.xf-yun.com/x2
IFLYTEK_MODEL=spark-x

# 方案 C：其他 OpenAI 兼容服务
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# MODEL_PROVIDER 留空则按 GLM_API_KEY / DEEPSEEK_API_KEY 的配置自动选择。
# 当前生产使用：MODEL_PROVIDER=deepseek + DEEPSEEK_MODEL=deepseek-flash。
# deepseek-flash 是推理模型，客户端会自动补 {"thinking":{"type":"disabled"}}；
# 不关闭思考时 max_tokens 会被 reasoning 吃光、content 为空并返回 503。
# 图像识别为本地 OpenCV（vision_agent.py），不经过任何模型，切换 provider 不影响它。
MODEL_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MONITORING_ENABLED=false
MONITORING_INTERVAL_SECONDS=21600
PUBLIC_DATA_API_KEY=

# 助手知识资料目录
ASSISTANT_KNOWLEDGE_DIR=data/assistant_knowledge
ASSISTANT_MAX_FILE_MB=10

# ====== 数据存储 ======
UPLOAD_DIR=uploads
REPORT_DIR=reports
DATA_DIR=data
RULES_DIR=rules

# ====== 审查配置 ======
AUDIT_TIMEOUT_SECONDS=60
MAX_IMAGE_SIZE_MB=5
